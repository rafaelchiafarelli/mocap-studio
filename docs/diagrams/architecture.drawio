<mxCell id="c35" value="&lt;font color='#666666'&gt;Phase 2 (not in the baseline): live forwarding of frames to the processing PC, Harpia database, distributed workers, face/emotion/gaze pipeline. Parked: ESP32 LED flash sync (mocap-sync-fw).&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1150" height="40" as="geometry"/></mxCell>
