<mxCell id="c2" value="&lt;b style='font-size:18px'&gt;Mocap Studio — architecture&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;closed 2026-10-05 · see HANDOFF.md&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="Cameras (7 planned)" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="230" height="520" as="geometry"/></mxCell>
<mxCell id="c4" value="&lt;b&gt;4 × body&lt;/b&gt;&lt;br&gt;full body incl. feet,&lt;br&gt;hands, arms, head" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="55" y="100" width="200" height="90" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b&gt;1 × face&lt;/b&gt;&lt;br&gt;(face pipeline: phase 2)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="55" y="205" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b&gt;2 × hands&lt;/b&gt;&lt;br&gt;(still in doubt)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="55" y="280" width="200" height="60" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b&gt;UVC&lt;/b&gt; &lt;font color='#999999' style='font-size:9px'&gt;PARKED&lt;/font&gt; source&lt;br&gt;USB webcam&lt;br&gt;&lt;font style='font-size:10px'&gt;no webcam will be used&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#bbbbbb;fontColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="55" y="370" width="200" height="80" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b&gt;STREAM&lt;/b&gt; source&lt;br&gt;tablet/phone + &lt;b&gt;mocap-camera-app&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;stream protocol v1: H.264 + capture&lt;br&gt;time in SEI, UDP clock sync&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="55" y="465" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="c9" value="Recorder PC — Linux" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="330" y="60" width="380" height="520" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;P1 Setup&lt;/b&gt; · mocap-capture&lt;br&gt;&lt;font style='font-size:10px'&gt;config, board, locked controls, calibration take + quick check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="345" y="100" width="350" height="55" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;P2 Record&lt;/b&gt; · mocap-capture&lt;br&gt;&lt;font style='font-size:10px'&gt;one file per camera · per-frame host_ts_ns on the&lt;br&gt;recorder clock · START/END sync markers · take report&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="345" y="170" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;Preprocess&lt;/b&gt; per role · CPU only, no neural nets&lt;br&gt;&lt;font style='font-size:10px'&gt;crop / rescale, one output frame per input frame&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="345" y="255" width="350" height="55" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;Hand-off&lt;/b&gt; per file, as soon as each is ready&lt;br&gt;&lt;font style='font-size:10px'&gt;1. rsync the file  2. write its sidecar  3. publish the event&lt;br&gt;timestamps + TakeClosed at END · each video when preprocessed&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="345" y="325" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;Session folder&lt;/b&gt; (mocap_contracts.layout)&lt;br&gt;&lt;font style='font-size:10px'&gt;take.json · report.json · raw/&amp;lt;role&amp;gt;.mkv + .timestamps.csv&lt;br&gt;prep/&amp;lt;role&amp;gt;.mkv · closed.json · &amp;lt;file&amp;gt;.ready.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="345" y="410" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;Live monitor&lt;/b&gt; (director view)&lt;br&gt;&lt;font style='font-size:10px'&gt;latest frame per camera, never slows recording&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="345" y="495" width="350" height="60" as="geometry"/></mxCell>
<mxCell id="c16" value="Processing PC — Windows + WSL2, RTX 4080" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="810" y="60" width="380" height="520" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;mocap-extract watch&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;verifies each file against its sidecar; on restart&lt;br&gt;rescans sidecars (folder = the record, events = the nudge)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="825" y="100" width="350" height="70" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;P3 Extract&lt;/b&gt; · mocap-extract (all neural nets)&lt;br&gt;&lt;font style='font-size:10px'&gt;alignment when TakeClosed + timestamps are in&lt;br&gt;resample + 2D per camera as each video lands&lt;br&gt;triangulation + quality when every role is in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="825" y="185" width="350" height="85" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;P4 Adapt&lt;/b&gt; · mocap-adapt&lt;br&gt;&lt;font style='font-size:10px'&gt;smoothing, feet on the floor → mocap_take.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="825" y="285" width="350" height="55" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;P5 Blender&lt;/b&gt; 5.2 LTS · mocap-blender add-on&lt;br&gt;&lt;font style='font-size:10px'&gt;animated empties, NLA: locked base + correction&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="825" y="355" width="350" height="55" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;Session folder&lt;/b&gt; — same layout, filled file by file&lt;br&gt;&lt;font style='font-size:10px'&gt;+ extract/ · adapt/ · blender/&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="825" y="425" width="350" height="55" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;mocap-contracts&lt;/b&gt; — the only shared code. &lt;font style='font-size:10px'&gt;.harpia messages (one module per owner) → &lt;b&gt;Harpia V3&lt;/b&gt; Python target (black box) → committed Python package, re-exported as mocap_contracts. Session, Take, SyncEvent, TakeReport, ExtractIndex, MocapTake, TakeClosed, CameraFileReady, camera.harpia (also generated for Java, for the app) + stream protocol v1 spec + the session folder layout. Every repo imports it; no repo imports another.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1150" height="70" as="geometry"/></mxCell>
