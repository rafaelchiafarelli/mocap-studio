<mxCell id="c2" value="&lt;b style='font-size:18px'&gt;Mocap Studio — pipeline P1–P5&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;each box: step number, owner repo, ▶ In / ◀ Out · task files trace back to these numbers&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1500" height="40" as="geometry"/></mxCell>
<mxCell id="c3" value="Recorder PC" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="25" y="55" width="600" height="900" as="geometry"/></mxCell>
<mxCell id="c4" value="Processing PC" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="645" y="55" width="885" height="900" as="geometry"/></mxCell>
<mxCell id="c5" value="&lt;b style='font-size:13px'&gt;P1 Setup&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="270" height="24" as="geometry"/></mxCell>
<mxCell id="c6" value="&lt;b style='font-size:13px'&gt;P2 Capture&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="330" y="90" width="270" height="24" as="geometry"/></mxCell>
<mxCell id="c7" value="&lt;b style='font-size:13px'&gt;P3 Extract&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="90" width="270" height="24" as="geometry"/></mxCell>
<mxCell id="c8" value="&lt;b style='font-size:13px'&gt;P4 Adapt&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="90" width="270" height="24" as="geometry"/></mxCell>
<mxCell id="c9" value="&lt;b style='font-size:13px'&gt;P5 Blender&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="90" width="270" height="24" as="geometry"/></mxCell>
<mxCell id="c10" value="&lt;b&gt;1.1 Cameras &amp;amp; roles&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: config.yaml (roles, UVC/STREAM, preprocess, handoff)&lt;br&gt;◀ Out: CameraConfig per role, PreprocessSpec per role&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c11" value="&lt;b&gt;1.2 Board &amp;amp; locked controls&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture/studio-setup&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: CalibrationBoard (session.json), controls:&lt;br&gt;◀ Out: board printed + verified; CameraControls applied&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c12" value="&lt;b&gt;1.3 Calibration take + quick check&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture/studio-setup&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: board, cameras&lt;br&gt;◀ Out: calibration take (recorded through P2); pass/fail before actors&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="332" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c13" value="&lt;b&gt;2.1 Record&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: CameraConfig; UVC frames / STREAM H.264&lt;br&gt;◀ Out: raw/&amp;lt;role&amp;gt;.mkv (no re-encode), take.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="120" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c14" value="&lt;b&gt;2.2 Per-frame timestamps&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: UVC wall clock / STREAM SEI capture time + clock sync&lt;br&gt;◀ Out: raw/&amp;lt;role&amp;gt;.timestamps.csv (frame, host_ts_ns)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="226" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c15" value="&lt;b&gt;2.3 Sync markers&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: operator START / END&lt;br&gt;◀ Out: SyncEvent START/END (host clock) in take.json&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="332" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c16" value="&lt;b&gt;2.4 Take report&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: timestamps, frames per role&lt;br&gt;◀ Out: report.json (TakeReport: fps, gaps)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="426" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c17" value="&lt;b&gt;2.5 Preprocess (per role)&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: raw/&amp;lt;role&amp;gt;.mkv + PreprocessSpec&lt;br&gt;◀ Out: prep/&amp;lt;role&amp;gt;.mkv, applied_preprocess; CPU only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="520" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c18" value="&lt;b&gt;2.6 Hand-off (per file)&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;capture&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: take.json, timestamps (at END), prep videos (as ready)&lt;br&gt;◀ Out: files on processing PC + sidecars; events TakeClosed, CameraFileReady&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="330" y="626" width="270" height="105" as="geometry"/></mxCell>
<mxCell id="c19" value="&lt;b&gt;3.0 Intake / watch&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;extract&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: events + closed.json, &amp;lt;file&amp;gt;.ready.json&lt;br&gt;◀ Out: verified files, take_state; dispatches each step when its inputs are in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="120" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c20" value="&lt;b&gt;3.1 Alignment&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;extract&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: take.json, timestamps, prep videos&lt;br&gt;◀ Out: extract/synced/&amp;lt;role&amp;gt;.mp4 (CFR, same frame count, START→END)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="226" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c21" value="&lt;b&gt;3.1c Calibration&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;extract&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: calibration take (synced)&lt;br&gt;◀ Out: camera intrinsics/extrinsics, ground plane (Z up)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="332" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c22" value="&lt;b&gt;3.2 Body and hands&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;extract · FreeMoCap&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: synced videos + calibration&lt;br&gt;◀ Out: per-camera 2D, body/hands 3D, extract/index.json (ExtractIndex)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="438" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c23" value="&lt;b&gt;3.3 Quality&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;extract&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: 2D, 3D, calibration&lt;br&gt;◀ Out: extract/quality.json + quality.md (per-camera metrics, ablation)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="660" y="544" width="270" height="92" as="geometry"/></mxCell>
<mxCell id="c24" value="&lt;b&gt;4.1 Timeline&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;adapt&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: extract/index.json&lt;br&gt;◀ Out: TakeData on one timeline; gaps marked&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="120" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c25" value="&lt;b&gt;4.2 Smoothing&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;adapt&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: TakeData&lt;br&gt;◀ Out: filtered TakeData (configurable filter)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="214" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c26" value="&lt;b&gt;4.3 Ground contact&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;adapt&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: filtered TakeData&lt;br&gt;◀ Out: foot contact + foot lock&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="308" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c27" value="&lt;b&gt;4.4 Export&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;adapt&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: TakeData&lt;br&gt;◀ Out: adapt/mocap_take.json (MocapTake: meters, Z up)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="950" y="402" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c28" value="&lt;b&gt;5.1 Import&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;blender&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: adapt/mocap_take.json&lt;br&gt;◀ Out: animated empties (Action)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="120" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c29" value="&lt;b&gt;5.2 NLA layers&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;blender&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: Action&lt;br&gt;◀ Out: locked base track + correction track (Combine)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="214" width="270" height="80" as="geometry"/></mxCell>
<mxCell id="c30" value="&lt;b&gt;5.3 FreeMoCap add-on bridge&lt;/b&gt; &lt;font color='#666666' style='font-size:9px'&gt;blender&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;▶ In: Action / empties&lt;br&gt;◀ Out: rig driven through the FreeMoCap add-on&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1240" y="308" width="270" height="80" as="geometry"/></mxCell>
