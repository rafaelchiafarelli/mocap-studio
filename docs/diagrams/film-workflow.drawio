<diagram id="film-workflow" name="film-workflow">
<mxGraphModel dx="1800" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="830" math="0" shadow="0">
<root>
<mxCell id="0" />
<mxCell id="1" parent="0" />
<mxCell id="c2" value="&lt;b style='font-size:18px'&gt;How a film gets made: the projects as steps&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#666666'&gt;Each step and the project that owns it&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="10" width="1740" height="40" as="geometry" /></mxCell>
<mxCell id="c3" value="Pre-production" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="560" as="geometry" /></mxCell>
<mxCell id="c4" value="Production" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="335" y="60" width="1000" height="560" as="geometry" /></mxCell>
<mxCell id="c5" value="Post-production" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="1350" y="60" width="210" height="560" as="geometry" /></mxCell>
<mxCell id="c6" value="Delivery" style="swimlane;html=1;startSize=28;rounded=1;arcSize=2;fontSize=13;fontStyle=1;fillColor=#f5f5f5;strokeColor=#999999;swimlaneFillColor=none;" vertex="1" parent="1"><mxGeometry x="1575" y="60" width="205" height="560" as="geometry" /></mxCell>
<mxCell id="c7" value="&lt;b&gt;1. mocap-writer&lt;/b&gt;&lt;br&gt;Write the script and film bible, in Fountain" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="260" height="80" as="geometry" /></mxCell>
<mxCell id="c8" value="&lt;b&gt;2. mocap-preprod&lt;/b&gt;&lt;br&gt;AI agents turn the script into a brief, worklist and specs; the creator approves" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="40" y="205" width="260" height="88" as="geometry" /></mxCell>
<mxCell id="c9" value="&lt;b&gt;3. mocap-previz&lt;/b&gt;&lt;br&gt;Script to shot list, 3D blocking and layered SVG storyboard" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="318" width="260" height="88" as="geometry" /></mxCell>
<mxCell id="c10" value="&lt;b&gt;4. mocap-blender (integration)&lt;/b&gt;&lt;br&gt;Build characters and sets with agent-driven tools" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="350" y="100" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c11" value="&lt;b&gt;5. mocap-camera-app&lt;/b&gt;&lt;br&gt;Turn tablets into streaming cameras" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="350" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c12" value="&lt;b&gt;6. mocap-capture&lt;/b&gt;&lt;br&gt;P1 setup, P2 record takes, preprocess and hand off" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="544" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c13" value="&lt;b&gt;7. mocap-extract&lt;/b&gt;&lt;br&gt;P3 align, calibrate, video to 3D body and hands" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="738" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c14" value="&lt;b&gt;8. mocap-adapt&lt;/b&gt;&lt;br&gt;P4 smooth the motion, put the feet on the floor" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="932" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c15" value="&lt;b&gt;9. mocap-blender (P5)&lt;/b&gt;&lt;br&gt;Motion onto the character, set up and render the shot" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="1126" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c16" value="&lt;b&gt;10. faces (mocap-studio)&lt;/b&gt;&lt;br&gt;Make the character's face perform" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="1126" y="365" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c17" value="&lt;b&gt;11. mocap-audio&lt;/b&gt;&lt;br&gt;Record, edit and generate voice, music and effects" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1126" y="495" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c18" value="&lt;b&gt;12. Edit, grade, mix&lt;/b&gt;&lt;br&gt;No project owns this yet" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bbbbbb;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1370" y="230" width="170" height="104" as="geometry" /></mxCell>
<mxCell id="c19" value="&lt;b&gt;13. Final delivery&lt;/b&gt;&lt;br&gt;No project owns this yet" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;fontSize=11;fillColor=#ffffff;strokeColor=#bbbbbb;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1595" y="230" width="165" height="104" as="geometry" /></mxCell>
