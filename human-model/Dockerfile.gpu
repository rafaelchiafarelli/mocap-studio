# The GPU image: hmcore's libraries plus NVIDIA Warp, for soft-tissue simulation on the RTX 4080. Run with hm.sh --gpu.
# Same base as Dockerfile. Warp brings its own CUDA runtime; the driver comes from the host through the NVIDIA Container Toolkit (setup_gpu_host.sh).
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
COPY requirements-gpu.txt /tmp/requirements-gpu.txt
RUN pip install --require-hashes --no-deps -r /tmp/requirements-gpu.txt
WORKDIR /repo
