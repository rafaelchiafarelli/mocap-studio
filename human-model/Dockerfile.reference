# tools/check_reference.py: judges photos and videos of real people as reference for the model. OpenCV's wheel needs libGL and glib.
FROM python:3.12-slim@sha256:b18b261e1b4974b4f321451ad5251ded85abb22c2b8b262da527dda1d031ab30
RUN apt-get update && apt-get install -y --no-install-recommends libgl1=1.7.0-1+b2 libglib2.0-0t64=2.84.4-3~deb13u5 && rm -rf /var/lib/apt/lists/*
COPY requirements-reference.txt /tmp/requirements.txt
RUN pip install --require-hashes --no-deps -r /tmp/requirements.txt
WORKDIR /repo
