<mxfile host="app.diagrams.net"><diagram id="transformacoes" name="Transformações"><mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1060" pageHeight="2617" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="Captura: duas câmeras → 3D métrico (two_cameras.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1f0e1;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="187" width="1010" height="896" as="geometry"/></mxCell><mxCell id="c2" value="Filtros do movimento (antes do Blender)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3e6f7;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="1093" width="1010" height="420" as="geometry"/></mxCell><mxCell id="c3" value="Retarget no Blender (drive_capture.py)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fde9d4;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="1523" width="1010" height="319" as="geometry"/></mxCell><mxCell id="c4" value="Tecido de tetraedros" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6eef8;strokeColor=none;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;fontStyle=1;opacity=60;" vertex="1" parent="1"><mxGeometry x="20" y="1852" width="1010" height="725" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Pose-capture: transformações dos dados, das duas câmeras ao tecido&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Azul = dados (arquivo, forma, sistema de coordenadas) · amarelo = transformação (programa · arquivo Typst com a matemática) · vermelho = ponto de atenção para a investigação · Typst em review/2026-11-15/transformacoes/typst (PDF em pdf/)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1010" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Saída do MediaPipe, duas câmeras&lt;/b&gt; · &lt;i&gt;a.npz, b.npz&lt;/i&gt;&lt;br&gt;image (T, 33, 4): x·W, y·H em pixel, z relativo, visibilidade ν · times (T) em s&lt;br&gt;(o 'world' de cada câmera não é usado) + som a.wav, b.wav + meta.json (ffprobe)" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="470" height="91" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;1. Sincronia pela palma&lt;/b&gt; · two_cameras.py · &lt;i&gt;01_sincronia.typ&lt;/i&gt;&lt;br&gt;envelope de ataques → correlação cruzada → d = 0,126 s&lt;br&gt;B interpolado nos instantes de A; trecho 31,46–42,85 s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="237" width="470" height="74" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;u_A(t), u_B(t), ν&lt;/b&gt; (T, 33): pixels das duas vistas no mesmo instante" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="337" width="470" height="46" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c7" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;2. Câmeras pelo corpo&lt;/b&gt; · two_cameras.py · &lt;i&gt;02_cameras.typ&lt;/i&gt;&lt;br&gt;K (pinhole, 26 mm) → matriz essencial (RANSAC) → R, t&lt;br&gt;refino: reprojeção + ossos rígidos + focal (Huber)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="409" width="470" height="74" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c9" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Calibração sem tabuleiro.&lt;/b&gt; Focal e posição relativa vêm do próprio corpo. Um erro aqui inclina o chão contra o corpo: a rampa de 9,9° da etapa 6 é esse erro, tirado só das alturas." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="409" width="400" height="74" as="geometry"/></mxCell><mxCell id="c14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c13" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;P_A = K_A [I | 0], P_B = K_B [R | t]&lt;/b&gt;, |t| = 1 · ângulo 82,6°" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="509" width="470" height="46" as="geometry"/></mxCell><mxCell id="c16" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c11" target="c15"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;3. Triangulação e esquerda/direita&lt;/b&gt; · &lt;i&gt;03_triangulacao.typ&lt;/i&gt;&lt;br&gt;DLT (SVD) por ponto; troca E/D por grupo se reprojeta 30% melhor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="581" width="470" height="60" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c15" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;X_j(t)&lt;/b&gt; (T, 33, 3) · espaço da câmera A, escala arbitrária" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="667" width="470" height="46" as="geometry"/></mxCell><mxCell id="c20" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c17" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;4. Esqueleto de ossos rígidos&lt;/b&gt; · &lt;i&gt;04_esqueleto_rigido.typ&lt;/i&gt;&lt;br&gt;por quadro: reprojeção ponderada por ν + 26 ossos + 'parado' (Huber)&lt;br&gt;só dos ombros para baixo; a cabeça fica triangulada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="739" width="470" height="74" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c19" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;Movimento abafado.&lt;/b&gt; O termo 'parado' (4) e as gaussianas das etapas 7 e 8 somam suavização. A inclinação da pelve em torno da reta dos quadris não é observável (só 2 pontos)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="739" width="400" height="74" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c23" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Y_j(t)&lt;/b&gt; (T, 33, 3) · câmera A, ossos de comprimento fixo" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="839" width="470" height="46" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;5. Métrico&lt;/b&gt; · &lt;i&gt;05_metrico.typ&lt;/i&gt;&lt;br&gt;para cima = mediana tornozelos→ombros; chão = P2 dos pés&lt;br&gt;escala pelos ombros (1,70 × 0,82); X = esquerda; P = s·M·(X − o)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="911" width="470" height="74" as="geometry"/></mxCell><mxCell id="c28" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c25" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;Escala por uma altura só&lt;/b&gt; (P75 dos ombros, razão 0,82): o erro dela passa a todos os comprimentos e ao caminho do quadril." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="911" width="400" height="74" as="geometry"/></mxCell><mxCell id="c30" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c29" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;two_cameras.npz&lt;/b&gt; · &lt;i&gt;06_duas_cameras_esqueleto_31-43s&lt;/i&gt;&lt;br&gt;points_m (T, 33, 3): m, Z para cima, chão 0, olha para −Y&lt;br&gt;world (T, 33, 3): o mesmo em torno do meio dos quadris, eixos do MediaPipe" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="1011" width="470" height="76" as="geometry"/></mxCell><mxCell id="c32" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c27" target="c31"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;6. Chão nivelado e contatos&lt;/b&gt; · foot_contacts.py · &lt;i&gt;06_chao_e_contatos.typ&lt;/i&gt;&lt;br&gt;plano z = a·x + b·y + c_k nos pontos parados → cisalhamento z −= a·x + b·y&lt;br&gt;altura de apoio pela marca (37,301 s, pé direito) → contato (≤ 40 mm, &amp;lt; 0,3 m/s)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1143" width="470" height="91" as="geometry"/></mxCell><mxCell id="c34" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c31" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;contatos.npz&lt;/b&gt; · &lt;i&gt;15_chao_e_contatos&lt;/i&gt;&lt;br&gt;points_m nivelado, world, contact (T, 2, 3) [E, D] × [tornozelo, calcanhar, ponta]" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="1260" width="470" height="61" as="geometry"/></mxCell><mxCell id="c36" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c33" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;7. Ganho por região&lt;/b&gt; · amplify_capture.py · &lt;i&gt;07_ganho.typ&lt;/i&gt;&lt;br&gt;bases por parte → rotação local → quatérnios em 3 faixas (0,3 / 6 Hz)&lt;br&gt;movimento × g (quadril 3); caminho do quadril H' = base + 3·mov + ruído&lt;br&gt;P' = H' + pose relativa (todos os pontos, inclusive os pés)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1347" width="470" height="88" as="geometry"/></mxCell><mxCell id="c38" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c35" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;CANDIDATO MAIS FORTE.&lt;/b&gt; O ganho multiplica o caminho do quadril, e os pés vão junto (P' = H' + pose relativa), sem as pernas compensarem. Os contatos foram medidos antes do ganho.&lt;br&gt;&lt;b&gt;Medido:&lt;/b&gt; deslize de um ponto do pé durante um contato: mediana 24 mm antes → &lt;b&gt;188 mm&lt;/b&gt; depois (p90 392, máx. 509)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="600" y="1347" width="400" height="88" as="geometry"/></mxCell><mxCell id="c40" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=2.5;" edge="1" parent="1" source="c39" target="c37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;nivelado_quadril_3.npz&lt;/b&gt; · &lt;i&gt;tet_v7_movimento&lt;/i&gt;&lt;br&gt;world', points_m'; contact &lt;b&gt;copiado sem mudar&lt;/b&gt;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="1461" width="470" height="56" as="geometry"/></mxCell><mxCell id="c42" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c37" target="c41"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;8. Retarget no corpo MPFB&lt;/b&gt; · drive_capture.py · &lt;i&gt;08_retarget.typ&lt;/i&gt;&lt;br&gt;gaussiana σ = 2 quadros; eixos (x, z, −y)&lt;br&gt;pelve e peito por bases; coluna por slerp; membros por swing + dobradiça&lt;br&gt;raiz: r_xy = k·(H − H₀), r_z = pé mais baixo no chão" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1573" width="470" height="91" as="geometry"/></mxCell><mxCell id="c44" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c41" target="c43"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;9. Pés presos&lt;/b&gt; · drive_capture.py (2 passadas) · &lt;i&gt;09_pes_presos_ik.typ&lt;/i&gt;&lt;br&gt;âncora do ponto apoiado → descida do quadril δ (suavizada)&lt;br&gt;IK de dois ossos no plano do joelho; pé com a rotação capturada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1690" width="470" height="74" as="geometry"/></mxCell><mxCell id="c46" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c43" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;A IK trata o sintoma.&lt;/b&gt; Para alcançar âncoras que o ganho deslocou, troca as direções capturadas da perna e baixa o quadril até 174 mm: joelhos dobrados que a pessoa não dobrou.&lt;br&gt;Também na etapa 8: translado (k·ΔH) e rotações (pernas do corpo, 1,59 m) não são forçados a concordar; r_z pelo pé mais baixo salta na troca de apoio." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="1690" width="400" height="100" as="geometry"/></mxCell><mxCell id="c48" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c47" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;movimento_quadril_3_pes_presos.blend&lt;/b&gt;&lt;br&gt;por quadro: quatérnio de cada osso (espaço da armadura) + rig.location" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="1790" width="470" height="56" as="geometry"/></mxCell><mxCell id="c50" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c45" target="c49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="&lt;b&gt;10a. Transformação por osso&lt;/b&gt; · tissue_motion_dump.py · &lt;i&gt;10_ossos_para_malha.typ&lt;/i&gt;&lt;br&gt;T_b(f) = W(f) · A_b(f) · (A_b^rep)⁻¹" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="1902" width="470" height="61" as="geometry"/></mxCell><mxCell id="c52" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c49" target="c51"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c53" value="&lt;b&gt;ossos_quadril_3.npz&lt;/b&gt; · T (341, ossos, 4, 4), do repouso MPFB ao mundo" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="1989" width="470" height="46" as="geometry"/></mxCell><mxCell id="c54" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c51" target="c53"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="&lt;b&gt;10b. Malha no quadro 1&lt;/b&gt; · tissue_mesh.py · &lt;i&gt;10_ossos_para_malha.typ&lt;/i&gt;&lt;br&gt;pele por LBS com T⁰ = T(1); faixas 3/6/9/12 mm; partes unidas ou separadas&lt;br&gt;(levadas de volta ao repouso pela pele de cada parte)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="2061" width="470" height="76" as="geometry"/></mxCell><mxCell id="c56" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c53" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Repouso do tecido = quadro 1 dessa pose&lt;/b&gt; (quadril baixado, pernas dobradas pela IK), com o afundamento do LBS nas juntas já embutido." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="2061" width="400" height="76" as="geometry"/></mxCell><mxCell id="c58" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c57" target="c55"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;tecidos.npz&lt;/b&gt; · &lt;i&gt;malha_v19&lt;/i&gt;&lt;br&gt;nós x⁰, tetraedros, nós guiados + osso, pele mostrada = tetraedro + pesos β" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="2163" width="470" height="61" as="geometry"/></mxCell><mxCell id="c60" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c55" target="c59"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;11a. Simulação&lt;/b&gt; · tissue_sim.py · &lt;i&gt;11_simulacao_e_montagem.typ&lt;/i&gt;&lt;br&gt;T^rel = T·(T⁰)⁻¹; nós guiados M = (1−α)T^rel(f−1) + αT^rel(f), 160 subpassos&lt;br&gt;XPBD Neo-Hookean + cola + contato; pele s = Σ β_k x_k" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="2250" width="470" height="76" as="geometry"/></mxCell><mxCell id="c62" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c59" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c63" value="&lt;b&gt;Interpolação linear de matrizes&lt;/b&gt; entre quadros: não é rotação (encolhe cos θ/2 no meio). As emendas de cabeça, mãos e pés vêm de duas fontes (LBS do Blender e simulação)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;fontSize=10;size=12;" vertex="1" parent="1"><mxGeometry x="600" y="2250" width="400" height="76" as="geometry"/></mxCell><mxCell id="c64" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#b85450;strokeWidth=1;" edge="1" parent="1" source="c63" target="c61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c65" value="&lt;b&gt;pele.pc2&lt;/b&gt; (341, 63 970, 3) · mundo" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="2352" width="470" height="46" as="geometry"/></mxCell><mxCell id="c66" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c61" target="c65"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c67" value="&lt;b&gt;11b. Montagem&lt;/b&gt; · tissue_assemble.py · &lt;i&gt;11_simulacao_e_montagem.typ&lt;/i&gt;&lt;br&gt;Mesh Cache (pele simulada) + HM_body só cabeça, mãos e pés (LBS do Blender)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacingLeft=8;fontSize=11;arcSize=8;" vertex="1" parent="1"><mxGeometry x="60" y="2424" width="470" height="61" as="geometry"/></mxCell><mxCell id="c68" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c65" target="c67"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c69" value="&lt;b&gt;tet_v7_tecidos.blend&lt;/b&gt; / tet_v7_cenario.blend" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;fontSize=11;size=0.12;" vertex="1" parent="1"><mxGeometry x="60" y="2511" width="470" height="40" as="geometry"/></mxCell><mxCell id="c70" value="" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="c67" target="c69"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>