          <mxGeometry x="40" y="118" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="pose de cada osso, um pouco mais perto da primeira pose da caminhada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="642" y="152" width="316" height="38" as="geometry" />
        </mxCell>
