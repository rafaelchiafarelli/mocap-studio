          <mxGeometry x="40" y="392.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="devolve as posições de novo, uma vez para cada tecido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
