          <mxGeometry x="100" y="276" width="1396" height="222" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="põe cada ponto preso onde o osso está neste instante do quadro" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
