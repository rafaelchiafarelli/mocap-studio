  <diagram id="p0" name="A · Preparar o corpo">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1210" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c1" value="&lt;b style='font-size:18px'&gt;A · Preparar o corpo&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="14" width="1110" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="&lt;font color='#555555'&gt;Etapas 1 a 6. Os números são do homem.&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="46" width="1110" height="24" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="110" as="sourcePoint" />
            <mxPoint x="290" y="774" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c4" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="110" as="sourcePoint" />
            <mxPoint x="630" y="774" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c5" value="" style="html=1;endArrow=none;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="110" as="sourcePoint" />
            <mxPoint x="970" y="774" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c6" value="&lt;b&gt;Arquivos (disco G:)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="180" y="72" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;b&gt;Simulador (processador)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="520" y="72" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;b&gt;GPU&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="860" y="72" width="220" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="pede as camadas, os ossos, a caminhada e os valores de tecido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="302" y="118" width="316" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="161" as="sourcePoint" />
            <mxPoint x="290" y="161" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;1&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="144" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="devolve a malha (pontos, tetraedros e o tecido de cada um), a forma dos ossos e a pose de cada osso em cada quadro" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="302" y="180" width="316" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="239" as="sourcePoint" />
            <mxPoint x="630" y="239" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c14" value="Separa os tetraedros abaixo de uma altura-limite e fica com o maior pedaço conectado. Hoje o limite é 10 m acima do quadril: entra o corpo inteiro." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="258" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;b&gt;2&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="282.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="Para cada ponto, acha o osso mais próximo e anota: é a sua referência. Ponto preso: qual osso seguir. Ponto de tecido: de qual osso medir o amortecimento." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="352" width="300" height="78" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;b&gt;3&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="376.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="Separa a pele e acha as 5 bordas em que ela foi cortada: pescoço, 2 pulsos e 2 tornozelos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="446" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="&lt;b&gt;4&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="454.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="Define os pontos presos: os que são osso e os que ficam além das bordas de corte. São 65 mil dos 558 mil." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="508" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="&lt;b&gt;5&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="524.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="Dá a cada tetraedro a rigidez e a densidade do seu tecido e divide todos em 48 grupos. Dentro de um grupo nenhum tetraedro compartilha ponto, então a GPU trata o grupo inteiro de uma vez." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="586" width="300" height="94" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;b&gt;6&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="618.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="envia pontos, tetraedros, massas e rigidez; os pontos presos recebem massa infinita: só o osso os move" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="642" y="696" width="316" height="54" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="755" as="sourcePoint" />
            <mxPoint x="970" y="755" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c26" value="Produz o resultado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="86" y="788" width="170" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="Só mede: não muda o movimento" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="266" y="788" width="230" height="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
