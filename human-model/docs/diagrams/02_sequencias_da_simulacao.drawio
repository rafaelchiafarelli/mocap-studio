        </mxCell>
        <mxCell id="c11" value="&lt;b&gt;↻ 24 quadros · 1 s&lt;/b&gt;" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fillColor=none;strokeColor=#888888;dashed=1;" vertex="1" parent="1">
