          <mxGeometry x="40" y="322.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="Mede o movimento da pele em relação ao modelo atual e conta os tetraedros invertidos." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="140" y="384" width="300" height="46" as="geometry" />
