        <mxCell id="c20" value="Recoloca a pele: cada ponto de pele está amarrado a um tetraedro e acompanha os 4 pontos dele." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
