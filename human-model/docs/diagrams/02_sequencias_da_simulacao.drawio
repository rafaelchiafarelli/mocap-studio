        <mxCell id="c26" value="Soma o volume de cada tecido em todos os tetraedros." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
