          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="195" as="sourcePoint" />
            <mxPoint x="970" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c15" value="Calcula o tecido: 160 passos (página C · etapa 11)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="214" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="a primeira pose da caminhada, parada" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="642" y="328" width="316" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="355" as="sourcePoint" />
            <mxPoint x="970" y="355" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c18" value="Calcula o tecido: 160 passos" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="374" width="300" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="Escolhe, em cada osso, os pontos a testar, sem os que estão perto dos cortes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="480" y="438" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;b&gt;9&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;fontSize=11;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="446.0" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="devolve a posição dos pontos já assentados" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="642" y="500" width="316" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="970" y="527" as="sourcePoint" />
            <mxPoint x="630" y="527" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c23" value="guarda o volume de cada tecido nesta pose: é a referência das medições" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="302" y="546" width="316" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#d79b00;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="630" y="589" as="sourcePoint" />
            <mxPoint x="290" y="589" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c25" value="Separa a metade de trás do corpo e as superfícies dela, por tecido: é o corte que aparece no Blender." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="608" width="300" height="62" as="geometry" />
