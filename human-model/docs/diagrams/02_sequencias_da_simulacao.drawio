            <mxPoint x="290" y="195" as="sourcePoint" />
            <mxPoint x="630" y="195" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c16" value="Soma a gravidade à velocidade, anda, e guarda onde estava." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="214" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="corrige seus pontos para recuperar a forma, conforme a rigidez do tecido" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="982" y="310" width="316" height="38" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1310" y="353" as="sourcePoint" />
            <mxPoint x="970" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c19" value="corrige de novo para recuperar o volume" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="982" y="372" width="316" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1310" y="399" as="sourcePoint" />
            <mxPoint x="970" y="399" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c21" value="Não saem do lugar: a correção só desloca os pontos livres. É assim que o osso empurra o tecido." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="480" y="418" width="300" height="62" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="informa quanto o osso de referência de cada ponto andou" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=bottom;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="302" y="514" width="656" height="22" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="" style="html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#6c8ebf;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="290" y="541" as="sourcePoint" />
            <mxPoint x="970" y="541" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="c24" value="Calcula a nova velocidade e amortece só a diferença para o movimento do osso." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="820" y="560" width="300" height="46" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;i&gt;Nenhum passo verifica colisão: o que mantém o osso sob a pele é só a malha de tecido entre eles.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="86" y="640" width="1404" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;i&gt;Existe um passo de chão, mas nesta simulação ele não atua: os pés não são simulados.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="86" y="670" width="1404" height="26" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="Produz o resultado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="86" y="714" width="170" height="26" as="geometry" />
