#!/usr/bin/env bash
# Toolbox for the camera stream app. The toolchain (JDK, Android SDK, Gradle, adb, ffmpeg) runs in Docker;
# the measuring scripts run on the PC's native Python (see scripts/env.sh). For the full evaluation use
# ./run-eval.sh; these are the individual steps.
set -euo pipefail
cd "$(dirname "$0")"
source scripts/env.sh

image() { docker build -t "$IMAGE" docker/; }
ensure_image() { docker image inspect "$IMAGE" >/dev/null 2>&1 || image; }

# Build/ffmpeg as the host user so outputs aren't root-owned.
as_user() {
    ensure_image
    mkdir -p .home .gradle-home
    docker run --rm -u "$(id -u):$(id -g)" \
        -e HOME=/work/.home -e GRADLE_USER_HOME=/work/.gradle-home \
        -v "$PWD:/work" -w /work --network host "$IMAGE" "$@"
}

# scripts/camctl.py (mocap-camera-app's control channel) in the control image, with mocap-contracts from
# the umbrella's submodule; host network, so the adb-forwarded ports are local.
camctl() {
    [ -f "$MOCAP_CONTRACTS/mocap_contracts/transport.py" ] || { echo "no mocap-contracts at $MOCAP_CONTRACTS (git submodule update --init ../mocap-contracts, or set MOCAP_CONTRACTS)" >&2; exit 1; }
    docker image inspect "$CONTROL_IMAGE" >/dev/null 2>&1 || docker build -q -t "$CONTROL_IMAGE" docker/control/ >/dev/null
    docker run --rm -u "$(id -u):$(id -g)" --network host -v "$PWD:/work" -v "$MOCAP_CONTRACTS:/contracts:ro" -w /work \
        -e PYTHONPATH=/contracts:/contracts/gen/python "$CONTROL_IMAGE" python scripts/camctl.py "$@"
}

# A long-lived adb server container, so connections and authorizations survive between commands.
# Its key lives in a Docker volume: devices that authorized it once stay authorized.
up() {
    ensure_image
    if [ "$(docker inspect -f '{{.State.Running}}' "$ADB_CONTAINER" 2>/dev/null)" = "true" ]; then return; fi
    docker rm -f "$ADB_CONTAINER" >/dev/null 2>&1 || true
    local usb=()
    if [ -d /dev/bus/usb ]; then
        usb=(--privileged -v /dev/bus/usb:/dev/bus/usb)
    else
        echo "note: /dev/bus/usb not present (WSL without usbipd attach) - only Wi-Fi adb will work" >&2
    fi
    docker run -d --name "$ADB_CONTAINER" --network host "${usb[@]}" \
        -v "$ADB_KEYS_VOLUME":/root/.android -v "$PWD:/work" -w /work \
        "$IMAGE" adb nodaemon server >/dev/null
    for _ in $(seq 20); do
        docker exec "$ADB_CONTAINER" adb devices >/dev/null 2>&1 && return
        sleep 0.5
    done
    echo "adb server did not come up (another adb server on port 5037?)" >&2
    docker logs "$ADB_CONTAINER" >&2
    exit 1
}

# T=<serial or ip:port> picks the device when more than one is connected.
adb() { up; docker exec -i ${T:+-e ANDROID_SERIAL="$T"} "$ADB_CONTAINER" adb "$@"; }
serials() { adb devices | awk 'NR>1 && $2=="device" {print $1}'; }
ip_of() { T="$1" adb shell ip -4 addr show wlan0 | awk '/inet /{sub(/\/.*/,"",$2); print $2}'; }
py() { "$(find_python)" "$@"; }

usage() {
    cat <<EOF
usage: [T=<serial|ip:port>] ./dev <command>     (T selects the device when several are connected)

 toolchain
  image                      build the Docker toolchain image
  build                      build the debug APK
  ffmpeg|ffprobe <args>      run ffmpeg/ffprobe from the image (paths relative to this folder)

 connecting (adb)
  up | down                  start / stop the adb server container
  devices                    list connected devices
  pair <ip:port> <code>      Wireless debugging pairing (Android 11+), once per device
  connect <ip[:port]>        connect over Wi-Fi (default port 5555)
  wadb <ip>                  find the Wireless debugging port by scanning, connect, pin adb to :5555
                             (no pairing needed if the device once authorized this PC over USB)
  tcpip                      switch a USB-connected device to Wi-Fi adb on :5555
  ips                        serial, model and Wi-Fi IP of every connected device
  adb <args...>              raw adb (inside the container)

 app
  install                    install the APK (camera permission granted)
  launch [w h fps mode q]    (re)start the app; mode h264|mjpeg, q = kbps (h264) or JPEG quality (mjpeg)
  provision <ip> [port] [pair-port code]
                             connect (pairing if a code is given), pin to :5555, install, launch
  install-all | launch-all   on every connected device
  logs                       follow the app's log
  info <ip>                  device capabilities from the app (/info)

 over HTTP (no adb)
  found                      devices running the app (\$SUBNET, default: this PC's subnet)
  ctl <ip|all> [k=v ...]     change settings: width height fps mode bitrate(kbps) quality facing
  measure <ip> [seconds] [--save-stream]   measure one device (native Python)
  multi [seconds]            measure every device found, at the same time, and compare their timing

 mocap-camera-app (ZeroMQ, ports forwarded by run-eval.sh --app camera)
  camctl <args>              scripts/camctl.py: info, stream, controls, stats, streaming, v1check (--help)
EOF
}

cmd="${1:-help}"; shift || true
case "$cmd" in
    image)   image ;;
    build)   as_user gradle --no-daemon -q assembleDebug && ls -l "$APK" ;;
    ffmpeg|ffprobe) as_user "$cmd" "$@" ;;
    up)      up; echo "adb server running in container $ADB_CONTAINER" ;;
    down)    docker rm -f "$ADB_CONTAINER" >/dev/null 2>&1 || true ;;
    devices) adb devices -l ;;
    pair)    adb pair "$@" ;;
    connect) target="$1"; [[ "$target" == *:* ]] || target="$target:5555"; adb connect "$target" ;;
    tcpip)   adb tcpip 5555 ;;
    wadb)
        ports=$(python3 scripts/findadb.py "$1")
        [ -n "$ports" ] || { echo "no Wireless debugging port open on $1 (is Wireless debugging on?)" >&2; exit 1; }
        ok=
        for p in $ports; do adb connect "$1:$p" | grep -qE "^(connected|already)" && { ok=$p; break; }; done
        [ -n "$ok" ] || { echo "could not connect to $1 on $ports (needs pairing: ./dev pair)" >&2; exit 1; }
        T="$1:$ok" adb tcpip 5555 && sleep 3 && adb connect "$1:5555"
        ;;
    ips)     for s in $(serials); do echo "$s $(T="$s" adb shell getprop ro.product.model | tr -d '\r') $(ip_of "$s")"; done ;;
    install) [ -f "$APK" ] || "$0" build; adb install -r -g "$APK" ;;
    launch)
        mode="${4:-h264}"; q="${5:-}"
        extra=(--ei quality "${q:-80}")
        [ "$mode" = h264 ] && extra=(--ei bitrate "$(( ${q:-20000} * 1000 ))")
        adb shell am start -S -n "$PKG/.MainActivity" \
            --ei width "${1:-1600}" --ei height "${2:-1200}" --ei fps "${3:-30}" \
            --es mode "$mode" "${extra[@]}" --es facing back
        ;;
    provision)
        ip="$1"; port="${2:-5555}"
        [ -n "${4:-}" ] && adb pair "$ip:$3" "$4"
        adb connect "$ip:$port"
        if [ "$port" != 5555 ]; then
            T="$ip:$port" adb tcpip 5555
            sleep 3
            adb connect "$ip:5555"
        fi
        T="$ip:5555" "$0" install
        T="$ip:5555" "$0" launch
        sleep 6
        curl -s --max-time 5 "http://$ip:$PORT/stats"; echo
        ;;
    install-all) [ -f "$APK" ] || "$0" build
             for s in $(serials); do echo "== $s"; T="$s" adb install -r -g "$APK"; done ;;
    launch-all) for s in $(serials); do echo "== $s"; T="$s" "$0" launch "$@"; done ;;
    logs)    adb logcat -s TabletStream:* AndroidRuntime:E ;;
    info)    curl -s --max-time 5 "http://$1:$PORT/info"; echo ;;
    found)   py scripts/discover.py ${SUBNET:+--subnet "$SUBNET"} ;;
    ctl)
        target="$1"; shift
        q=$(IFS='&'; echo "$*")
        if [ "$target" = all ]; then hosts=$("$0" found | awk '/^[0-9]/{print $1}'); else hosts="$target"; fi
        for h in $hosts; do echo "$h $(curl -s --max-time 5 "http://$h:$PORT/control?$q")"; done
        ;;
    measure) host="$1"; shift; secs="${1:-60}"; shift || true
             py scripts/measure.py --host "$host" --seconds "$secs" "$@" ;;
    multi)   py scripts/multi.py --seconds "${1:-90}" ;;
    camctl)  camctl "$@" ;;
    adb)     adb "$@" ;;
    *)       usage ;;
esac
